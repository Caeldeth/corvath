<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Hardened-runtime entitlements. Required once `hardenedRuntime: true` is set,
      which notarization in turn requires.

      Electron's V8 needs both JIT entitlements; without them the renderer crashes
      on launch under the hardened runtime. The unsigned-executable-memory one is
      what Electron's own docs call for, and is not a blanket relaxation — it
      permits writable-executable pages, nothing more.

      Nothing else is granted. Corvath talks to no network service of its own, uses
      no camera, microphone or location, and reads only files the user picks
      through the OS dialog, so no additional entitlement is justified. Add one
      only with a reason next to it.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
